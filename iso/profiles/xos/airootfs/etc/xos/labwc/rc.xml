<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
  </core>

  <keyboard>
    <numlock/>
  </keyboard>

  <!-- labwc 启动后自动运行会话脚本（此时 WAYLAND_DISPLAY 已就绪） -->
  <autostart>
    <command>/etc/xos/labwc/autostart</command>
  </autostart>

  <mouse>
    <doubleClickTime>500</doubleClickTime>
  </mouse>

  <!-- 快捷键 -->
  <keybind key="Super+Return">
    <action name="Execute"><command>alacritty</command></action>
  </keybind>
  <keybind key="Super+d">
    <action name="Execute"><command>xos-shell</command></action>
  </keybind>
  <keybind key="Super+q">
    <action name="Close"/>
  </keybind>
  <keybind key="Super+Shift+e">
    <action name="Exit"/>
  </keybind>

  <!-- 桌面背景色（后续阶段可换壁纸） -->
  <background>
    <color>#11111b</color>
  </background>
</labwc_config>
