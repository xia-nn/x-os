# labwc 环境文件（由 xos.desktop 通过 -C /etc/xos/labwc 指定）
# 这些变量会被注入到 Wayland 会话中所有客户端进程
QT_QPA_PLATFORM=wayland
XDG_CURRENT_DESKTOP=XOS
XDG_SESSION_TYPE=wayland
GDK_BACKEND=wayland

# 中文输入法（fcitx5）
GTK_IM_MODULE=fcitx
QT_IM_MODULE=fcitx
XMODIFIERS=@im=fcitx

# 高分屏缩放（自动按物理 DPI）
QT_AUTO_SCREEN_SCALE_FACTOR=1
GDK_SCALE=1
