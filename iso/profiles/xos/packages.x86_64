# X OS — Archiso 包清单（x86_64）
# 分类：引导/内核、基础用户态、显示管理+Wayland、预装应用、网络/音频、权限、字体、构建依赖

# ----- 引导 / 内核 -----
linux-lts
linux-firmware
mkinitcpio
grub
efibootmgr
syslinux
dosfstools

# ----- 基础用户态 -----
base
systemd
sudo

# ----- 显示管理 + Wayland 合成器 -----
sddm
labwc
qt6-base
qt6-declarative
qt6-wayland
qt6-svg
xdg-desktop-portal
xdg-desktop-portal-wlr
mesa
libinput

# ----- 预装应用（M0） -----
alacritty
pcmanfm
firefox

# ----- 网络 / 音频 -----
networkmanager
pipewire
wireplumber
pipewire-pulse

# ----- 权限 -----
polkit

# ----- 字体（中文支持） -----
noto-fonts
noto-fonts-cjk
noto-fonts-emoji

# ===== 阶段1：基础系统打磨 =====

# 安装器（Live -> 硬盘）
# NOTE: calamares 在 Arch 官方仓库不存在，位于 AUR。先注释掉以让 ISO 构建成功；
#       后续可通过 AUR/chaotic-aur 在 customize_airootfs.sh 中安装并恢复启用。
# calamares

# 中文输入法（fcitx5）
fcitx5
fcitx5-qt
fcitx5-chinese-addons
fcitx5-configtool

# 蓝牙 / 电源 / 声音固件
bluez
bluez-utils
power-profiles-daemon
sof-firmware

# 显卡/硬件检测（开源驱动默认挂载；NVIDIA 走可选包）
vulkan-intel
vulkan-radeon

# 原子更新（OSTree / A-B 回滚）
ostree

# 用户目录 / 工具
xdg-user-dirs
xdg-utils

# xos-shell / xos-settings 构建依赖（customize_airootfs.sh 内编译，后续阶段可移除）
cmake
gcc
